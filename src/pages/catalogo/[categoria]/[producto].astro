---
import type { GetStaticPaths } from 'astro';
import { getImage } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/layout/PageHeader.astro';
import ProductGallery from '../../../components/catalog/ProductGallery.astro';
import ProductCard from '../../../components/catalog/ProductCard.astro';
import WhatsAppButton from '../../../components/ui/WhatsAppButton.astro';
import ReferenceNote from '../../../components/ui/ReferenceNote.astro';
import Icon from '../../../components/ui/Icon.astro';
import { PRICE_NOTE } from '../../../config/site';
import { quoteHrefFor } from '../../../config/navigation';
import { getCategory } from '../../../data/categories';
import { getSiteImage } from '../../../data/images';
import { products, getRelatedProducts, type Product } from '../../../data/products';
import { productMessage } from '../../../lib/whatsapp';
import { buildBreadcrumbSchema, buildProductSchema } from '../../../lib/seo';

export const getStaticPaths = (() =>
  products.map((product) => ({
    params: { categoria: product.category, producto: product.slug },
    props: { product },
  }))) satisfies GetStaticPaths;

interface Props {
  product: Product;
}

const { product } = Astro.props;
const category = getCategory(product.category)!;
const images = product.images.map(getSiteImage);
const related = getRelatedProducts(product);
const ogImage = await getImage({ src: images[0]!.src, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const categoryUrl = `/catalogo/${category.slug}/`;

const schema = [
  buildProductSchema(product, category.name, ogImage.src, Astro.site),
  buildBreadcrumbSchema(
    [
      { name: 'Inicio', path: '/' },
      { name: 'Catálogo', path: '/catalogo/' },
      { name: category.name, path: categoryUrl },
      { name: product.name, path: Astro.url.pathname },
    ],
    Astro.site,
  ),
].filter((item): item is Record<string, unknown> => item !== null);
---

<BaseLayout
  title={`${product.name} a medida en Pasto`}
  description={`${product.summary} ${PRICE_NOTE}. Madeartex Diseño, Pasto, Nariño.`}
  ogImage={ogImage.src}
  schema={schema}
>
  <PageHeader
    title={product.name}
    eyebrow={category.name}
    breadcrumbs={[
      { label: 'Inicio', href: '/' },
      { label: 'Catálogo', href: '/catalogo/' },
      { label: category.name, href: categoryUrl },
      { label: product.name },
    ]}
  />

  <section class="section product" aria-label="Detalle del producto">
    <div class="container product__grid">
      <div>
        <ProductGallery images={images} productName={product.name} />
        {images.some((image) => image.isReference) && <ReferenceNote />}
      </div>

      <div class="product__info">
        <p class="product__summary">{product.summary}</p>
        <p class="product__description">{product.description}</p>

        <div class="product__block">
          <h2>Características</h2>
          <ul class="product__checks">
            {product.features.map((feature) => <li><Icon name="check" size={18} /> {feature}</li>)}
          </ul>
        </div>

        <div class="product__block">
          <h2>Opciones de personalización</h2>
          <p class="product__hint">Aspectos que puedes consultar para adaptar el mueble a tu espacio:</p>
          <ul class="product__tags">
            {product.customization.map((item) => <li>{item}</li>)}
          </ul>
        </div>

        <div class="product__block">
          <h2>Materiales y acabados</h2>
          {
            product.materials.length > 0 ? (
              <ul class="product__tags">{product.materials.map((material) => <li>{material}</li>)}</ul>
            ) : (
              <p class="product__hint">
                Consulta los materiales y acabados disponibles al solicitar tu cotización.
              </p>
            )
          }
        </div>

        <div class="product__cta">
          <p class="product__price">{PRICE_NOTE}</p>
          <WhatsAppButton message={productMessage(product.name)} label="Consultar por WhatsApp" block />
          <a href={quoteHrefFor(product.slug)} class="btn btn--outline btn--block">Solicitar cotización con el formulario</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="related-title">
    <div class="container">
      <h2 id="related-title" class="related__title">También te puede interesar</h2>
      <ul class="related__grid">
        {related.map((item) => <li><ProductCard product={item} /></li>)}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .product {
    padding-top: var(--space-6);
  }

  .product__grid {
    display: grid;
    gap: var(--space-7);
  }

  .product__info {
    display: grid;
    gap: var(--space-5);
    align-content: start;
  }

  .product__summary {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 600;
    line-height: 1.35;
  }

  .product__description {
    color: var(--charcoal-700);
  }

  .product__block {
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }

  .product__block h2 {
    margin-bottom: var(--space-3);
    font-size: var(--text-lg);
    font-weight: 700;
  }

  .product__checks {
    list-style: none;
    display: grid;
    gap: var(--space-2);
  }

  .product__checks li {
    display: flex;
    gap: var(--space-2);
    align-items: flex-start;
  }

  .product__checks :global(svg) {
    flex: none;
    margin-top: 0.2em;
    color: var(--color-primary);
  }

  .product__hint {
    margin-bottom: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .product__tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .product__tags li {
    padding: 4px 12px;
    border-radius: 999px;
    background: var(--wood-100);
    color: var(--charcoal-800);
    font-size: var(--text-sm);
  }

  .product__cta {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-5);
    border-radius: var(--radius);
    background: var(--cream);
    border: 1px solid var(--color-border);
  }

  .product__price {
    font-family: var(--font-display);
    font-weight: 700;
  }

  .related__title {
    margin-bottom: var(--space-6);
    font-size: var(--text-2xl);
  }

  .related__grid {
    list-style: none;
    display: grid;
    gap: var(--space-5);
  }

  @media (min-width: 640px) {
    .related__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .product__grid {
      grid-template-columns: 1.2fr 1fr;
      gap: var(--space-8);
    }

    .product__grid > div:first-child {
      position: sticky;
      top: calc(var(--header-h) + var(--space-5));
      align-self: start;
    }

    .related__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
