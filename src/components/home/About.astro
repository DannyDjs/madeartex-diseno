---
import { Image } from 'astro:assets';
import emblem from '../../assets/brand/emblema-madeartex.png';
import Icon, { type IconName } from '../ui/Icon.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { siteConfig } from '../../config/site';
import { getSiteImage } from '../../data/images';

/**
 * Contenido corporativo EDITABLE. Los bloques con `content: null` no se
 * muestran al público hasta que la empresa proporcione el texto real
 * (historia, misión, visión, experiencia, diferenciadores, fotos del taller).
 */
const corporateBlocks: { title: string; content: string | null }[] = [
  { title: 'Nuestra historia', content: null },
  { title: 'Misión', content: null },
  { title: 'Visión', content: null },
  { title: 'Experiencia', content: null },
];

const pillars: { icon: IconName; title: string; text: string }[] = [
  { icon: 'ruler', title: 'Diseño', text: 'Cada mueble parte de una idea y de las medidas de un espacio real.' },
  { icon: 'archive', title: 'Fabricación', text: 'Transformamos el diseño en muebles para el hogar y otros ambientes.' },
  { icon: 'sparkle', title: 'Personalización', text: 'Adaptamos dimensiones, distribución y estilo a cada necesidad.' },
];

const visibleBlocks = corporateBlocks.filter((block) => block.content);
const workshop = getSiteImage('taller');
---

<section class="section section--alt about" id="nosotros" aria-labelledby="about-title">
  <div class="container about__grid">
    <div class="about__media">
      <Image
        src={workshop.src}
        alt="Banco de trabajo de carpintería con herramientas y piezas de madera"
        widths={[480, 720, 960]}
        sizes="(min-width: 1024px) 520px, 100vw"
        loading="lazy"
        class="about__photo"
      />
      <div class="about__badge">
        <Image src={emblem} alt="" width={120} height={120} densities={[1, 2]} format="webp" loading="lazy" />
      </div>
      {workshop.isReference && <p class="about__ref">Imagen de referencia</p>}
    </div>

    <div class="about__content">
      <SectionHeading eyebrow="Nosotros" title={siteConfig.name} id="about-title">
        {siteConfig.slogan}.
      </SectionHeading>

      <p class="about__text">
        Somos una empresa de {siteConfig.location.city}, {siteConfig.location.region}, dedicada al diseño, la
        fabricación y la personalización de muebles para diferentes espacios del hogar y otros ambientes. Nos
        motiva crear piezas funcionales que reflejen la personalidad de quienes las usan.
      </p>

      <ul class="about__pillars">
        {
          pillars.map((pillar) => (
            <li>
              <Icon name={pillar.icon} size={22} />
              <div>
                <h3>{pillar.title}</h3>
                <p>{pillar.text}</p>
              </div>
            </li>
          ))
        }
      </ul>

      {
        visibleBlocks.length > 0 && (
          <div class="about__blocks">
            {visibleBlocks.map((block) => (
              <div>
                <h3>{block.title}</h3>
                <p>{block.content}</p>
              </div>
            ))}
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }

  .about__media {
    position: relative;
    margin-bottom: var(--space-6);
  }

  .about__media :global(.about__photo) {
    width: 100%;
    aspect-ratio: 5 / 4;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }

  .about__badge {
    position: absolute;
    right: var(--space-5);
    bottom: calc(-1 * var(--space-6));
    padding: var(--space-2);
    border-radius: 50%;
    background: var(--white);
    box-shadow: var(--shadow-lg);
  }

  .about__badge :global(img) {
    width: 96px;
    height: 96px;
  }

  .about__ref {
    position: absolute;
    left: var(--space-3);
    top: var(--space-3);
    padding: 2px 8px;
    border-radius: 999px;
    background: rgb(0 0 0 / 0.5);
    color: var(--white);
    font-size: 0.7rem;
  }

  .about__content :global(.section-heading) {
    margin-bottom: var(--space-5);
  }

  .about__text {
    font-size: var(--text-lg);
    color: var(--charcoal-700);
  }

  .about__pillars {
    list-style: none;
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  .about__pillars li {
    display: flex;
    gap: var(--space-4);
    padding: var(--space-4);
    border-radius: var(--radius);
    background: var(--white);
    border: 1px solid var(--color-border);
  }

  .about__pillars :global(svg) {
    flex: none;
    color: var(--color-primary);
  }

  h3 {
    font-size: var(--text-base);
    font-weight: 700;
  }

  .about__pillars p,
  .about__blocks p {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .about__blocks {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  @media (min-width: 1024px) {
    .about__grid {
      grid-template-columns: 1fr 1.1fr;
      gap: var(--space-8);
    }

    .about__media {
      margin-bottom: 0;
    }
  }
</style>
