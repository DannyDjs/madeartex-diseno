---
import Icon from './Icon.astro';
import { withBase } from '../../lib/paths';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<p class:list={['reference-note', className]}>
  <Icon name="info" size={16} />
  <span>
    Las fotografías son imágenes ilustrativas de referencia y no corresponden a trabajos realizados por
    Madeartex Diseño. <a href={withBase('/creditos/')}>Ver créditos</a>.
  </span>
</p>

<style>
  .reference-note {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    margin-top: var(--space-5);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .reference-note :global(svg) {
    margin-top: 0.2em;
    flex: none;
  }

  a {
    color: var(--color-primary);
    font-weight: 600;
  }
</style>
