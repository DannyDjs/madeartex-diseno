---
import { Image } from 'astro:assets';
import Icon from '../ui/Icon.astro';
import { categories, categoryUrl } from '../../data/categories';
import { getSiteImage } from '../../data/images';
import { getProductsByCategory } from '../../data/products';
---

<ul class="category-grid">
  {
    categories.map((category, index) => {
      const image = getSiteImage(category.image);
      const count = getProductsByCategory(category.slug).length;
      return (
        <li class:list={['category-tile', index === 0 && 'category-tile--wide']}>
          <a href={categoryUrl(category.slug)} class="category-tile__link">
            <Image
              src={image.src}
              alt=""
              widths={[480, 720, 960]}
              sizes="(min-width: 1024px) 400px, (min-width: 640px) 50vw, 100vw"
              loading="lazy"
              class="category-tile__image"
            />
            <span class="category-tile__shade" aria-hidden="true" />
            <span class="category-tile__content">
              <span class="category-tile__name">{category.name}</span>
              <span class="category-tile__includes">{category.includes.join(' · ')}</span>
              <span class="category-tile__more">
                Ver {count} {count === 1 ? 'opción' : 'opciones'} <Icon name="arrow-right" size={16} />
              </span>
            </span>
          </a>
        </li>
      );
    })
  }
</ul>

<style>
  .category-grid {
    list-style: none;
    display: grid;
    gap: var(--space-4);
  }

  .category-tile__link {
    position: relative;
    display: block;
    height: 100%;
    min-height: 240px;
    overflow: hidden;
    border-radius: var(--radius);
    color: var(--white);
    text-decoration: none;
    isolation: isolate;
  }

  .category-tile__link :global(.category-tile__image) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
    transition: transform 700ms var(--ease);
  }

  .category-tile__link:hover :global(.category-tile__image),
  .category-tile__link:focus-visible :global(.category-tile__image) {
    transform: scale(1.05);
  }

  .category-tile__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(0deg, rgb(10 12 8 / 0.85) 0%, rgb(10 12 8 / 0.35) 55%, rgb(10 12 8 / 0.05) 100%);
  }

  .category-tile__content {
    position: absolute;
    inset: auto 0 0 0;
    display: grid;
    gap: var(--space-1);
    padding: var(--space-5);
  }

  .category-tile__name {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    line-height: 1.2;
  }

  .category-tile__includes {
    font-size: var(--text-sm);
    color: rgb(255 255 255 / 0.82);
  }

  .category-tile__more {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-2);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--wood-200);
  }

  .category-tile__more :global(svg) {
    transition: transform var(--duration) var(--ease);
  }

  .category-tile__link:hover .category-tile__more :global(svg) {
    transform: translateX(4px);
  }

  @media (min-width: 640px) {
    .category-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .category-tile--wide {
      grid-column: span 2;
    }

    .category-tile__link {
      min-height: 280px;
    }
  }

  @media (min-width: 1024px) {
    .category-grid {
      grid-template-columns: repeat(3, 1fr);
      grid-auto-rows: 280px;
    }

    .category-tile--wide {
      grid-column: span 2;
      grid-row: span 2;
    }
  }
</style>
