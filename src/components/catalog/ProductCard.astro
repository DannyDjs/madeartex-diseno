---
import { Image } from 'astro:assets';
import Icon from '../ui/Icon.astro';
import { PRICE_NOTE } from '../../config/site';
import { quoteHrefFor } from '../../config/navigation';
import { getCategory } from '../../data/categories';
import { getSiteImage } from '../../data/images';
import { productUrl, type Product } from '../../data/products';
import { buildWhatsAppLink, productMessage } from '../../lib/whatsapp';

interface Props {
  product: Product;
  headingLevel?: 'h2' | 'h3';
}

const { product, headingLevel: Heading = 'h3' } = Astro.props;
const category = getCategory(product.category);
const image = getSiteImage(product.images[0]!);
const detailUrl = productUrl(product);
const whatsappHref = buildWhatsAppLink(productMessage(product.name));
const quoteUrl = whatsappHref ?? quoteHrefFor(product.slug);
---

<article class="product-card" data-category={product.category}>
  <a href={detailUrl} class="product-card__media" tabindex="-1" aria-hidden="true">
    <Image
      src={image.src}
      alt=""
      widths={[400, 640, 800]}
      sizes="(min-width: 1024px) 380px, (min-width: 640px) 45vw, 92vw"
      loading="lazy"
      class="product-card__image"
    />
    {image.isReference && <span class="product-card__ref">Referencia</span>}
  </a>

  <div class="product-card__body">
    {category && <p class="product-card__category">{category.name}</p>}
    <Heading class="product-card__title">
      <a href={detailUrl}>{product.name}</a>
    </Heading>
    <p class="product-card__summary">{product.summary}</p>

    <div class="product-card__custom">
      <p class="product-card__custom-label">Personalizable en:</p>
      <ul>
        {product.customization.slice(0, 3).map((item) => <li>{item}</li>)}
      </ul>
    </div>

    <p class="product-card__price">{PRICE_NOTE}</p>

    <div class="product-card__actions">
      <a href={detailUrl} class="btn btn--outline btn--sm">
        Consultar producto<span class="visually-hidden">: {product.name}</span>
      </a>
      <a
        href={quoteUrl}
        class="btn btn--sm"
        {...whatsappHref ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
      >
        {whatsappHref && <Icon name="whatsapp" />}
        Solicitar cotización<span class="visually-hidden">: {product.name}</span>
      </a>
    </div>
  </div>
</article>

<style>
  .product-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--white);
    transition:
      box-shadow var(--duration) var(--ease),
      transform var(--duration) var(--ease);
  }

  .product-card:hover {
    box-shadow: var(--shadow);
    transform: translateY(-3px);
  }

  .product-card[hidden] {
    display: none;
  }

  .product-card__media {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--gray-100);
  }

  .product-card__media :global(.product-card__image) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms var(--ease);
  }

  .product-card:hover :global(.product-card__image) {
    transform: scale(1.04);
  }

  .product-card__ref {
    position: absolute;
    left: var(--space-3);
    top: var(--space-3);
    padding: 2px 8px;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.9);
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--charcoal-700);
  }

  .product-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5);
  }

  .product-card__category {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--wood-600);
  }

  .product-card__title {
    font-size: var(--text-xl);
    font-weight: 700;
  }

  .product-card__title a {
    text-decoration: none;
  }

  .product-card__title a:hover {
    color: var(--color-primary);
  }

  .product-card__summary {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .product-card__custom-label {
    margin-bottom: var(--space-2);
    font-size: var(--text-xs);
    font-weight: 600;
  }

  .product-card__custom ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .product-card__custom li {
    padding: 2px 10px;
    border-radius: 999px;
    background: var(--green-50);
    color: var(--green-800);
    font-size: var(--text-xs);
  }

  .product-card__price {
    margin-top: auto;
    padding-top: var(--space-3);
    border-top: 1px dashed var(--color-border);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--charcoal-800);
  }

  .product-card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .product-card__actions .btn {
    flex: 1 1 auto;
    white-space: nowrap;
  }
</style>
