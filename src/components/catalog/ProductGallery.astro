---
import { Image, getImage } from 'astro:assets';
import type { SiteImage } from '../../data/images';

interface Props {
  images: SiteImage[];
  productName: string;
}

const { images, productName } = Astro.props;
const altFor = (index: number) =>
  images.length > 1 ? `${productName}, imagen ${index + 1} de ${images.length}` : productName;

// Versiones medianas precalculadas para el cambio de imagen con JavaScript.
const swaps = await Promise.all(
  images.map(async (image) => {
    const result = await getImage({ src: image.src, widths: [640, 960, 1280], sizes: '(min-width: 1024px) 640px, 100vw', format: 'webp' });
    return { src: result.src, srcset: result.srcSet.attribute };
  }),
);
const first = images[0]!;
---

<div class="product-gallery" data-product-gallery>
  <div class="product-gallery__main">
    <Image
      src={first.src}
      alt={altFor(0)}
      widths={[640, 960, 1280]}
      sizes="(min-width: 1024px) 640px, 100vw"
      format="webp"
      loading="eager"
      fetchpriority="high"
      data-gallery-main
    />
    {first.isReference && <span class="product-gallery__ref">Imagen de referencia</span>}
  </div>

  {
    images.length > 1 && (
      <ul class="product-gallery__thumbs" aria-label="Seleccionar imagen">
        {images.map((image, index) => (
          <li>
            <button
              type="button"
              class="product-gallery__thumb"
              aria-pressed={index === 0 ? 'true' : 'false'}
              aria-label={`Ver imagen ${index + 1} de ${images.length}`}
              data-src={swaps[index]!.src}
              data-srcset={swaps[index]!.srcset}
              data-alt={altFor(index)}
            >
              <Image src={image.src} alt="" width={160} height={120} densities={[1, 2]} loading="lazy" />
            </button>
          </li>
        ))}
      </ul>
    )
  }
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-product-gallery]').forEach((gallery) => {
    const main = gallery.querySelector<HTMLImageElement>('[data-gallery-main]');
    const thumbs = gallery.querySelectorAll<HTMLButtonElement>('.product-gallery__thumb');
    thumbs.forEach((thumb) => {
      thumb.addEventListener('click', () => {
        if (!main) return;
        main.srcset = thumb.dataset.srcset ?? '';
        main.src = thumb.dataset.src ?? '';
        main.alt = thumb.dataset.alt ?? '';
        thumbs.forEach((t) => t.setAttribute('aria-pressed', String(t === thumb)));
      });
    });
  });
</script>

<style>
  .product-gallery {
    display: grid;
    gap: var(--space-3);
  }

  .product-gallery__main {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--gray-100);
  }

  .product-gallery__main :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .product-gallery__ref {
    position: absolute;
    left: var(--space-3);
    top: var(--space-3);
    padding: 2px 8px;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.9);
    font-size: 0.7rem;
    font-weight: 600;
  }

  .product-gallery__thumbs {
    list-style: none;
    display: flex;
    gap: var(--space-3);
  }

  .product-gallery__thumb {
    display: block;
    width: 96px;
    padding: 0;
    overflow: hidden;
    border: 2px solid transparent;
    border-radius: var(--radius-sm);
    background: none;
    cursor: pointer;
    opacity: 0.7;
    transition:
      opacity var(--duration) var(--ease),
      border-color var(--duration) var(--ease);
  }

  .product-gallery__thumb:hover,
  .product-gallery__thumb[aria-pressed='true'] {
    opacity: 1;
  }

  .product-gallery__thumb[aria-pressed='true'] {
    border-color: var(--color-primary);
  }

  .product-gallery__thumb :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
</style>
