---
interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  eyebrow?: string;
  breadcrumbs?: Crumb[];
}

const { title, eyebrow, breadcrumbs = [] } = Astro.props;
---

<section class="page-header">
  <div class="container">
    {
      breadcrumbs.length > 0 && (
        <nav aria-label="Ruta de navegación" class="breadcrumbs">
          <ol>
            {breadcrumbs.map((crumb) => (
              <li>{crumb.href ? <a href={crumb.href}>{crumb.label}</a> : <span aria-current="page">{crumb.label}</span>}</li>
            ))}
          </ol>
        </nav>
      )
    }
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {Astro.slots.has('default') && <div class="page-header__lead"><slot /></div>}
  </div>
</section>

<style>
  .page-header {
    padding-block: var(--space-7) var(--space-6);
    background:
      linear-gradient(180deg, var(--wood-100) 0%, var(--white) 100%);
    border-bottom: 1px solid var(--color-border);
  }

  .breadcrumbs ol {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .breadcrumbs li:not(:last-child)::after {
    content: '/';
    margin-left: var(--space-2);
    color: var(--gray-400);
  }

  .breadcrumbs a {
    text-decoration: none;
  }

  .breadcrumbs a:hover {
    color: var(--color-primary);
    text-decoration: underline;
  }

  h1 {
    margin-top: var(--space-3);
    font-size: var(--text-3xl);
    font-weight: 800;
  }

  .page-header__lead {
    max-width: 65ch;
    margin-top: var(--space-4);
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }
</style>
